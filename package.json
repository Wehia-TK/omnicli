{
  "name": "omni-cli",
  "productName": "Omni CLI",
  "version": "1.0.0",
  "description": "Centralized desktop workspace for all your AI CLI subscriptions \u2014 Claude Code, Antigravity, Codex, and Copilot \u2014 with live limits, git worktrees, and a unified Project Knowledge Base.",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.omnicli.app",
    "productName": "Omni CLI",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "asarUnpack": [
      "node_modules/@lydell/**"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
