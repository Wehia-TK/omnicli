{
  "name": "omni-cli",
  "productName": "Omni CLI",
  "version": "1.0.0",
  "description": "Centralized desktop workspace for all your AI CLI subscriptions — Claude Code, Antigravity, Codex, and Copilot — with live limits, git worktrees, and a unified Project Knowledge Base.",
  "main": "out/main/index.js",
  "private": true,
  "license": "MIT",
  "author": "Yehia Tarek Khedr",
  "homepage": "https://github.com/YehiaTarekKhedr/omnicli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YehiaTarekKhedr/omnicli.git"
  },
  "bugs": {
    "url": "https://github.com/YehiaTarekKhedr/omnicli/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test test/*.test.mts",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "build": {
    "appId": "com.omnicli.app",
    "productName": "Omni CLI",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Omni CLI uses the microphone for voice input in the prompt box."
      }
    },
    "asarUnpack": [
      "node_modules/@lydell/**"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  }
}
